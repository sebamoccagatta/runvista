{
  "name": "runvista",
  "version": "0.0.0",
  "private": true,
  "description": "Pokemon streaming and overlay platform",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "pnpm -r --filter @runvista/web --filter @runvista/api run build",
    "dev": "pnpm --parallel --filter @runvista/web --filter @runvista/api run dev",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
