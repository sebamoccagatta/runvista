generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum ParticipantRole {
  OWNER
  PLAYER
  VIEWER
}

enum ChallengeType {
  NORMAL
  NUZLOCKE
  RANDOMLOCKE
  CUSTOM
}

enum RunPokemonStatus {
  TEAM
  BOX
  FAINTED
}

model User {
  sessions    Session[]
  id          String    @id @default(uuid()) @db.Uuid
  displayName String    @db.VarChar(100)
  twitchId    String?   @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedRuns      Run[]            @relation("RunOwner")
  participations RunParticipant[]
}

model Run {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(150)
  description String?   @db.Text
  status      RunStatus @default(DRAFT)

  ownerId String @db.Uuid
  owner   User   @relation("RunOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  participants  RunParticipant[]
  configuration RunConfiguration?
  pokemon       RunPokemon[]
  overlays      RunOverlay[]
  publishedTeam RunPublishedTeam?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model RunConfiguration {
  runId String @id @db.Uuid

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  gameId        String        @db.VarChar(80)
  challengeType ChallengeType @default(NORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RunPokemon {
  id String @id @default(uuid()) @db.Uuid

  runId String @db.Uuid
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  speciesId Int
  pokemonId Int?
  nickname  String? @db.VarChar(50)
  level     Int?
  isShiny   Boolean @default(false)

  status   RunPokemonStatus @default(BOX)
  teamSlot Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, teamSlot])
  @@index([runId, status])
}

model RunParticipant {
  id String @id @default(uuid()) @db.Uuid

  runId String @db.Uuid
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     ParticipantRole @default(PLAYER)
  joinedAt DateTime        @default(now())

  @@unique([runId, userId])
  @@index([userId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RunOverlay {
  id String @id @default(uuid()) @db.Uuid

  runId String @db.Uuid
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  name   String @db.VarChar(80)
  layout Json

  // Credencial recuperable del enlace OBS (identificador público).
  // Es un secreto de acceso: no debe incluirse en respuestas CRUD.
  obsPublicId String? @unique @db.VarChar(64)

  // Hash del token OBS de la versión anterior. Se conserva solo para
  // admitir enlaces antiguos; los enlaces nuevos usan obsPublicId.
  obsTokenHash String? @unique @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, name])
  @@index([runId])
}

model RunPublishedTeam {
  runId String @id @db.Uuid

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Instantánea de los Pokémon visibles en OBS. Solo cambia con una
  // publicación explícita, no al editar o mover Pokémon.
  team Json

  // Número de publicaciones realizadas.
  version Int @default(1)

  publishedAt DateTime @default(now())
}
