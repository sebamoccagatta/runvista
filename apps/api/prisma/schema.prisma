generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum ParticipantRole {
  OWNER
  PLAYER
  VIEWER
}

model User {
  sessions Session[]
  id          String  @id @default(uuid()) @db.Uuid
  displayName String  @db.VarChar(100)
  twitchId    String? @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedRuns      Run[]            @relation("RunOwner")
  participations RunParticipant[]
}

model Run {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(150)
  description String?   @db.Text
  status      RunStatus @default(DRAFT)

  ownerId String @db.Uuid
  owner   User   @relation("RunOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  participants RunParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model RunParticipant {
  id String @id @default(uuid()) @db.Uuid

  runId String @db.Uuid
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     ParticipantRole @default(PLAYER)
  joinedAt DateTime        @default(now())

  @@unique([runId, userId])
  @@index([userId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
