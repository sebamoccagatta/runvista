{
  "name": "@runvista/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @runvista/pokemon build && pnpm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm --filter @runvista/pokemon build && pnpm run db:generate && tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@runvista/pokemon": "workspace:*",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
