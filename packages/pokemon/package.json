{
  "name": "@runvista/pokemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/games.js",
  "types": "./dist/games.d.ts",
  "exports": {
    ".": {
      "types": "./dist/games.d.ts",
      "import": "./dist/games.js"
    },
    "./species": {
      "types": "./dist/species.d.ts",
      "import": "./dist/species.js"
    },
    "./varieties": {
      "types": "./dist/varieties.d.ts",
      "import": "./dist/varieties.js"
    },
    "./pokeballs": {
      "types": "./dist/pokeballs.d.ts",
      "import": "./dist/pokeballs.js"
    },
    "./badges": {
      "types": "./dist/badges.d.ts",
      "import": "./dist/badges.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:species": "node scripts/generate-species.mjs",
    "generate:varieties": "node scripts/generate-varieties.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
