
# Texto normalizado en Git
* text=auto

# Archivos de desarrollo
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Prisma y configuración
*.prisma text eol=lf
*.toml text eol=lf

# Scripts Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Recursos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
